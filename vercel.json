{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lucky-badgers-sort.loca.lt/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://lucky-badgers-sort.loca.lt/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://lucky-badgers-sort.loca.lt/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
