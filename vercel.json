{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://slightly-great-equal-bailey.trycloudflare.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://slightly-great-equal-bailey.trycloudflare.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://slightly-great-equal-bailey.trycloudflare.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
